---
import { withBase } from '@cloudflare/nimbus-docs/runtime';
import { logo } from './logo';

/** CWD 品牌标识，复用原文档的本地图标。 */
interface Props {
	/** 由页眉或移动导航传入的尺寸类名。 */
	class?: string;
}

const { class: className = 'h-7 w-7' } = Astro.props;
---

<img src={withBase(logo.src, import.meta.env.BASE_URL)} alt="" width="32" height="32" class:list={['object-contain', className]} />
